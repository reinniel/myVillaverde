{
  "name": "myvillaverde-local-guide",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/build-production.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/utils/navigationHistory.test.ts src/utils/places.test.ts src/utils/placesDataState.test.ts",
    "check": "npm run lint && npm test && npm run build",
    "data:sync": "node scripts/sync-places-fallback.mjs",
    "data:check": "node scripts/sync-places-fallback.mjs --check",
    "verify": "npm run data:check && npm run check"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/leaflet": "^1.9.21"
  }
}
